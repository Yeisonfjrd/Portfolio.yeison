---
// A river of light filaments that snakes down the whole page behind the content.
// Drawn once as SVG over the document's height (it scrolls with the page for free), in two layers
// with different waves that crossfade with a CSS opacity animation. Nothing runs per frame on the
// main thread: the compositor does all the motion. Rebuilt only when the page size changes.
---

<div class="ribbon" aria-hidden="true">
  <svg class="ribbon-a"></svg>
  <svg class="ribbon-b"></svg>
</div>
<!-- a veil fixed to the lower part of the screen: the river shows above it and is revealed as you scroll -->
<div class="ribbon-veil" aria-hidden="true"></div>

<script>
  const root = document.querySelector<HTMLElement>(".ribbon")!;
  const layers = [root.querySelector<SVGSVGElement>(".ribbon-a")!, root.querySelector<SVGSVGElement>(".ribbon-b")!];
  const NS = "http://www.w3.org/2000/svg";
  const STRANDS = 40;

  // seeded random so a rebuild after resize keeps the same look
  let seed = 7;
  const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
  const strands = Array.from({ length: STRANDS }, (_, i) => ({ k: i / (STRANDS - 1) - 0.5, phase: rnd() * 6.28, bright: rnd() < 0.12 }));

  function build() {
    const W = document.documentElement.clientWidth;
    const H = innerHeight;
    const D = document.documentElement.scrollHeight;
    const period = H * 1.3;
    const ang = (y: number) => (y / period) * Math.PI + 0.9;
    const centre = (y: number) => W * (0.5 + 0.34 * Math.sin(ang(y)));
    const slope = (y: number) => W * 0.34 * Math.cos(ang(y)) * (Math.PI / period);
    const spread = (y: number) => Math.min(W, H) * (0.03 + 0.2 * Math.abs(Math.sin(ang(y))));
    const step = 28; // px between points down the page
    const startY = H * 0.62; // the river starts under the name, not at the top edge
    root.style.height = `${D}px`;

    layers.forEach((svg, li) => {
      svg.setAttribute("viewBox", `0 0 ${W} ${D}`);
      svg.setAttribute("width", String(W));
      svg.setAttribute("height", String(D));
      svg.replaceChildren();
      const groups: Record<string, string[]> = { faint: [], mid: [], bright: [] };
      for (const st of strands) {
        let d = "";
        for (let y = startY; y <= D + step; y += step) {
          // the second layer gets a shifted wave; crossfading the two makes the bundle shimmer
          const wave = Math.sin(y / 220 + st.phase + li * 2.1) * 0.09 + Math.sin(y / 520 + st.phase - li * 1.3) * 0.05;
          const off = (st.k + wave) * spread(y);
          const m = slope(y), len = Math.hypot(1, m);
          const x = centre(y) + off / len, yy = y - (off * m) / len;
          d += `${d ? "L" : "M"}${x.toFixed(1)} ${yy.toFixed(1)}`;
        }
        groups[st.bright ? "bright" : Math.abs(st.k) > 0.25 ? "faint" : "mid"].push(d);
      }
      const add = (paths: string[], stroke: string, width: number) => {
        const p = document.createElementNS(NS, "path");
        p.setAttribute("d", paths.join(""));
        p.setAttribute("stroke", stroke);
        p.setAttribute("stroke-width", String(width));
        svg.appendChild(p);
      };
      add(groups.faint, "rgba(139, 92, 246, 0.16)", 1);
      add(groups.mid, "rgba(124, 58, 237, 0.28)", 1);
      add(groups.bright, "rgba(167, 139, 250, 0.25)", 5); // glow: wide and faint
      add(groups.bright, "rgba(124, 58, 237, 0.6)", 1.3); //       under thin and strong
    });
  }

  build();
  // the page grows as images load and fonts swap; rebuild only when its size really changes
  let size = "", timer = 0;
  new ResizeObserver(() => {
    const next = `${document.documentElement.clientWidth}x${document.documentElement.scrollHeight}`;
    if (next === size) return;
    size = next;
    clearTimeout(timer);
    timer = window.setTimeout(build, 150);
  }).observe(document.body);
</script>

<style>
  .ribbon { position: absolute; top: 0; left: 0; width: 100%; z-index: -2; pointer-events: none; overflow: hidden; contain: layout paint;
    -webkit-mask-image: linear-gradient(to bottom, transparent 55vh, #000 80vh); mask-image: linear-gradient(to bottom, transparent 55vh, #000 80vh); }
  .ribbon-veil {
    position: fixed; left: 0; right: 0; top: 72vh; height: 60vh; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(217, 210, 231, 0) 0, #d9d2e7 22vh); /* taste-skill-ignore: a scrim, the page's own ground */
  }
  .ribbon svg { position: absolute; top: 0; left: 0; fill: none; stroke-linecap: round; }
  /* compositor-only motion: two waves of the same river fading into each other */
  .ribbon-b { opacity: 0; will-change: opacity, transform; }
  @media (prefers-reduced-motion: no-preference) {
    .ribbon-a { animation: ribbon-drift 9s ease-in-out infinite alternate; will-change: transform; }
    .ribbon-b { animation: ribbon-shimmer 4.5s ease-in-out infinite alternate; }
  }
  @media (prefers-reduced-motion: reduce) { .ribbon-veil { display: none; } }
  @keyframes ribbon-shimmer { from { opacity: 0; transform: translateY(-18px); } to { opacity: 1; transform: translateY(18px); } }
  @keyframes ribbon-drift { from { transform: translateY(-10px); } to { transform: translateY(10px); } }
</style>
