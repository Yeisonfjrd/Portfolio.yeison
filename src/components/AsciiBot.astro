---
// My face in ASCII (generated from /Yeison-fajardo.webp) that answers recruiter questions.
// Answers are written from facts that are already on this page; anything else goes to email.
import face from "@/data/face.txt?raw";
import { siteConfig } from "@/data/site";

const lines = face.replace(/\r/g, "").split("\n").filter((l, i, a) => i < a.length - 1 || l.trim());
const questions = [
  "¿Quién sos?",
  "¿Qué estudiás?",
  "¿Con qué tecnologías trabajás?",
  "¿Tenés experiencia laboral?",
  "¿Qué buscás?",
  "¿Por qué backend?",
];
---

<div class="bot" data-email={siteConfig.links.email} data-linkedin={siteConfig.links.linkedin}>
  <pre class="bot-face" aria-hidden="true" data-lines={JSON.stringify(lines)}>{lines.join("\n")}</pre>
  <p class="bot-say" aria-live="polite">Hola, soy Yeison en ASCII. Preguntame lo que le preguntarías en una entrevista.</p>
  <div class="bot-asks">
    {questions.map((q) => <button type="button" class="key">{q}</button>)}
  </div>
  <form class="bot-form">
    <label class="sr-only" for="bot-q">Tu pregunta</label>
    <input id="bot-q" name="q" type="text" autocomplete="off" placeholder="O escribí tu pregunta" />
    <button class="key" type="submit">Preguntar</button>
  </form>
</div>

<script>
  type Answer = { keys: string[]; text: string };
  const root = document.querySelector<HTMLElement>(".bot")!;
  const pre = root.querySelector<HTMLPreElement>(".bot-face")!;
  const say = root.querySelector<HTMLParagraphElement>(".bot-say")!;
  const input = root.querySelector<HTMLInputElement>("#bot-q")!;
  const email = root.dataset.email!;
  const base: string[] = JSON.parse(pre.dataset.lines!);

  const answers: Answer[] = [
    { keys: ["quien", "sos", "presenta", "vos", "nombre", "edad", "anos"], text: "Soy Yeison Fajardo, tengo 21 años y vivo en Buenos Aires. Estudio la Tecnicatura en Desarrollo de Software en la UPE y busco mi primer trabajo como desarrollador backend." },
    { keys: ["estudi", "carrera", "universidad", "facultad", "upe", "formacion", "curso", "titulo"], text: "Curso la Tecnicatura en Desarrollo de Software en la Universidad Provincial de Ezeiza desde 2025. Antes hice cursos de backend, React y JavaScript con MySQL en Aprende Programando (con la UTN) y uno de Big O y estructuras de datos en Udemy." },
    { keys: ["tecnolog", "stack", "lenguaje", "java", "spring", "typescript", "node", "go", "postgres", "framework", "herramienta"], text: "Sobre todo Java 21 con Spring Boot, TypeScript con Node y Fastify, Go con Gin y PostgreSQL (con pgvector y Flyway). Para interfaces uso React y Next.js, y en todos mis proyectos tengo CI con GitHub Actions." },
    { keys: ["experiencia", "trabaj", "empresa", "laboral", "empleo", "junior"], text: "Todavía no trabajé formalmente como desarrollador. Lo que tengo son proyectos propios con tests y CI donde encontré y arreglé bugs reales: un pedido que vendía stock que no había, una búsqueda que dejaba ver documentos de otros usuarios, fechas que fallaban en UTC-3. Están todos más abajo, con su código." },
    { keys: ["proyecto", "mejor", "orgullo", "hiciste", "portfolio"], text: "TechLab: reescribí un simulador de tienda en JavaScript como una API en Spring Boot. Dos compras del último producto al mismo tiempo lo vendían dos veces; con optimistic locking la segunda recibe 409." },
    { keys: ["busc", "puesto", "rol", "pasantia", "posicion", "interesa"], text: "Un puesto junior o una pasantía de backend. Para hablar de modalidad y horarios, escribime y lo vemos." },
    { keys: ["backend", "porque", "gusta", "elegiste"], text: "Me gusta la parte del software que solo se nota cuando falla: dos pedidos que llegan a la vez, datos que no tendrías que ver, una fecha en la zona horaria equivocada." },
    { keys: ["ingles", "idioma", "english"], text: "Intermedio: estoy cursando el nivel 4 de 6 en el Centro de Idiomas de la UPE." },
    { keys: ["salario", "sueldo", "pretension", "cobrar", "plata", "remuneracion"], text: `Eso prefiero hablarlo directamente. Escribime a ${email}.` },
    { keys: ["remoto", "presencial", "hibrido", "horario", "disponib", "modalidad", "cuando"], text: `Para modalidad, horarios y disponibilidad, escribime a ${email} y lo hablamos.` },
    { keys: ["contacto", "mail", "correo", "linkedin", "contactar", "hablar"], text: `Por mail a ${email} o por LinkedIn. Los dos están acá abajo.` },
  ];
  const fallback = `No tengo una respuesta preparada para eso. Escribime a ${email} y te contesto yo.`;

  const normalize = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9 ]/g, " ");
  function answerFor(q: string): string {
    const words = normalize(q).split(/\s+/).filter(Boolean);
    let best: Answer | null = null;
    let bestScore = 0;
    for (const a of answers) {
      const score = a.keys.reduce((n, k) => n + (words.some((w) => w.startsWith(k) || (k.length > 3 && w.includes(k))) ? 1 : 0), 0);
      if (score > bestScore) { best = a; bestScore = score; }
    }
    return best ? best.text : fallback;
  }

  // The mouth sits on rows 25-27, centred on column 26 of the 54-column face
  const MOUTH_ROW = 25, MOUTH_COL = 20;
  const mouths = [
    null, // closed: the original smile
    ["=*#########*=", " *@@@@@@@@@* ", "  =*#####*=  "],
    ["=*#########*=", "*@@@@@@@@@@@*", " =*@@@@@@@*= "],
  ];
  function draw(frame: number) {
    const m = mouths[frame];
    if (!m) { pre.textContent = base.join("\n"); return; }
    const out = base.slice();
    m.forEach((part, i) => {
      const row = out[MOUTH_ROW + i];
      out[MOUTH_ROW + i] = row.slice(0, MOUTH_COL) + part + row.slice(MOUTH_COL + part.length);
    });
    pre.textContent = out.join("\n");
  }

  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let talking = 0;
  async function speak(text: string) {
    const id = ++talking;
    if (still) { say.textContent = text; return; }
    say.textContent = "";
    for (let i = 0; i < text.length; i++) {
      if (id !== talking) return; // a newer question interrupted this one
      say.textContent += text[i];
      // vowels open the mouth wider, spaces and punctuation close it
      const ch = text[i].toLowerCase();
      draw(/[aeoáéó]/.test(ch) ? 2 : /[iuíú]/.test(ch) ? 1 : /[\s.,:;]/.test(ch) ? 0 : i % 2);
      await new Promise((r) => setTimeout(r, /[.,:]/.test(ch) ? 90 : 26));
    }
    draw(0);
  }

  root.querySelectorAll<HTMLButtonElement>(".bot-asks button").forEach((b) =>
    b.addEventListener("click", () => speak(answerFor(b.textContent ?? ""))),
  );
  root.querySelector("form")!.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (q) speak(answerFor(q));
  });
</script>
