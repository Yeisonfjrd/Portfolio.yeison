---
// My face drawn as stacked horizontal lines (thicker where the photo is darker), inside a ring of
// ticks and violet arcs with dots orbiting it. Composition borrowed from animejs.com's hero.
const SIZE = 560;
const C = SIZE / 2;
const ticks = Array.from({ length: 120 }, (_, i) => (i / 120) * Math.PI * 2);
// arcs: [start, end] in turns, each a shade of the violet palette
const arcs: [number, number, string][] = [
  [0.0, 0.14, "#7c3aed"],
  [0.16, 0.3, "#a78bfa"],
  [0.32, 0.47, "#5b21b6"],
  [0.49, 0.63, "#c4b5fd"],
  [0.65, 0.81, "#6d28d9"],
  [0.83, 0.98, "#8b5cf6"],
];
const arcPath = (r: number, a0: number, a1: number) => {
  const p = (t: number) => [C + r * Math.cos(t * 2 * Math.PI - Math.PI / 2), C + r * Math.sin(t * 2 * Math.PI - Math.PI / 2)];
  const [x0, y0] = p(a0);
  const [x1, y1] = p(a1);
  return `M${x0.toFixed(1)} ${y0.toFixed(1)} A${r} ${r} 0 ${a1 - a0 > 0.5 ? 1 : 0} 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`;
};
const dots = Array.from({ length: 16 }, (_, i) => i);
---

<div class="portrait" role="img" aria-label="Retrato de Yeison Fajardo dibujado con líneas">
  <canvas class="ring-face" width={SIZE} height={SIZE}></canvas>
  <svg class="ring-svg" viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
    <defs>
      <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    <g class="ring-ticks">
      {ticks.map((t) => (
        <line x1={C + 226 * Math.cos(t)} y1={C + 226 * Math.sin(t)} x2={C + 236 * Math.cos(t)} y2={C + 236 * Math.sin(t)} />
      ))}
    </g>
    <g class="ring-arcs" filter="url(#glow)">
      {arcs.map(([a0, a1, color]) => <path d={arcPath(256, a0, a1)} stroke={color} />)}
    </g>
    <g class="ring-orbit">
      {dots.map((i) => <circle cx={C} cy={C - 246} r={4.2 - i * 0.22} opacity={1 - i / 16} transform={`rotate(${-i * 3.2} ${C} ${C})`} />)}
    </g>
  </svg>
</div>

<script>
  import { animate, stagger } from "animejs";

  const fig = document.querySelector<HTMLElement>(".portrait")!;
  const canvas = fig.querySelector<HTMLCanvasElement>(".ring-face")!;
  const ctx = canvas.getContext("2d")!;
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const SIZE = 560, C = SIZE / 2, R = 206; // the face fills a circle of radius R inside the ring
  const ROWS = 62, COLS = 96;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width = SIZE * dpr;
  canvas.height = SIZE * dpr;
  ctx.scale(dpr, dpr);

  // Darkness of the photo per cell, sampled once from the face crop of /Yeison-fajardo.webp
  const dark = new Float32Array(ROWS * COLS);
  const rows = Array.from({ length: ROWS }, () => ({ p: still ? 1 : 0 }));
  const mouse = { x: -1e4, y: -1e4, k: 0 };

  const img = new Image();
  img.src = "/Yeison-fajardo.webp";
  img.onload = () => {
    const s = document.createElement("canvas");
    s.width = COLS;
    s.height = ROWS;
    const g = s.getContext("2d")!;
    // a square crop around the face (the circle is square, so the source must be too)
    g.drawImage(img, 380, 500, 660, 660, 0, 0, COLS, ROWS);
    const d = g.getImageData(0, 0, COLS, ROWS).data;
    let lo = 255, hi = 0;
    const lum = new Float32Array(ROWS * COLS);
    for (let i = 0; i < lum.length; i++) {
      lum[i] = 0.2126 * d[i * 4] + 0.7152 * d[i * 4 + 1] + 0.0722 * d[i * 4 + 2];
      lo = Math.min(lo, lum[i]);
      hi = Math.max(hi, lum[i]);
    }
    for (let i = 0; i < lum.length; i++) dark[i] = Math.pow(1 - (lum[i] - lo) / (hi - lo), 1.25);
    start();
  };

  function draw(t: number) {
    ctx.clearRect(0, 0, SIZE, SIZE);
    const rowGap = (2 * R) / ROWS;
    const colW = (2 * R) / COLS;
    for (let r = 0; r < ROWS; r++) {
      const p = rows[r].p;
      if (p <= 0) continue;
      const y = C - R + (r + 0.5) * rowGap;
      const dy = y - C;
      const half = Math.sqrt(Math.max(0, R * R - dy * dy)); // circle chord at this row
      const wave = still ? 0 : Math.sin(t / 900 + r * 0.32) * 2.2; // the breathing
      for (let c = 0; c < COLS; c++) {
        const x0 = C - R + c * colW;
        const xc = x0 + colW / 2;
        if (Math.abs(xc - C) > half * p) continue; // circular mask, opening from the centre
        let v = dark[r * COLS + c];
        // fade toward the rim so the background behind the head dissolves
        const rim = Math.hypot(xc - C, dy) / R;
        v *= rim > 0.82 ? Math.max(0, (1 - rim) / 0.18) : 1;
        if (v < 0.08) continue;
        // the cursor pushes the lines sideways, strongest at its centre
        const md = Math.hypot(xc - mouse.x, y - mouse.y);
        const push = mouse.k * Math.exp(-(md * md) / 3200) * 26 * Math.sign(xc - mouse.x || 1);
        const h = Math.max(0.6, v * rowGap * 0.92);
        ctx.fillStyle = md < 90 && mouse.k > 0.05 ? "#7c3aed" : "#2e1065";
        ctx.fillRect(x0 + wave + push, y - h / 2, colW + 0.4, h);
      }
    }
  }

  let raf = 0, visible = true;
  const loop = (t: number) => {
    draw(t);
    mouse.k *= 0.94;
    if (visible) raf = requestAnimationFrame(loop);
  };

  function start() {
    if (still) { draw(0); return; }
    // rows arrive from the middle outward, like the stacked lines of animejs.com
    animate(rows, { p: 1, duration: 900, ease: "outExpo", delay: stagger(14, { from: "center" }) });
    animate(".ring-ticks line", { opacity: [0.15, 0.9, 0.15], duration: 2400, delay: stagger(20), loop: true, ease: "inOutSine" });
    animate(".ring-arcs", { rotate: 360, duration: 60000, loop: true, ease: "linear" });
    animate(".ring-orbit", { rotate: 360, duration: 7000, loop: true, ease: "linear" });
    raf = requestAnimationFrame(loop);
    // stop drawing while the hero is off screen
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible) raf = requestAnimationFrame(loop);
    }).observe(fig);
  }

  fig.addEventListener("pointermove", (e) => {
    const b = canvas.getBoundingClientRect();
    mouse.x = ((e.clientX - b.left) / b.width) * SIZE;
    mouse.y = ((e.clientY - b.top) / b.height) * SIZE;
    mouse.k = 1;
  });
  fig.addEventListener("pointerleave", () => { mouse.x = mouse.y = -1e4; });
</script>

<style>
  .portrait { position: relative; margin: 0; width: 100%; max-width: 560px; aspect-ratio: 1; justify-self: end; }
  .ring-face, .ring-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring-ticks line { stroke: #2e1065; stroke-width: 1.4; opacity: 0.35; }
  .ring-arcs path { fill: none; stroke-width: 6; stroke-linecap: round; }
  .ring-arcs, .ring-orbit { transform-origin: 50% 50%; transform-box: view-box; }
  .ring-orbit circle { fill: #7c3aed; }
  @media (prefers-reduced-motion: reduce) { .ring-ticks line { opacity: 0.4; } }
</style>
