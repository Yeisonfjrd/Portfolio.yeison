---
import Site from "@/layouts/Site.astro";
import { projects } from "@/data/projects";
import { siteConfig } from "@/data/site";
import EnergyRibbon from "@/components/EnergyRibbon.astro";

const work = projects.filter((p) => p.index);
const shots: Record<string, { src: string; alt: string }> = {
  "rental-cars": { src: "/projects/rental-cars.png", alt: "Portada de RoadEra" },
  "garmin-coach-mcp": { src: "/shots/ci-matrix.png", alt: "CI de garmin-coach-mcp en verde, con tests en UTC y en hora de Buenos Aires" },
  "pingpong-scoreboard": { src: "/projects/pingpong-scoreboard.png", alt: "Marcador de ping pong" },
};
const extraLinks: Record<string, { href: string; label: string }> = {
  "garmin-coach-mcp": { href: "https://www.npmjs.com/package/garmin-coach-mcp", label: "npm" },
};
// Gmail's compose window, in a new tab: mailto opens a desktop mail app most people never set up
const mail = `https://mail.google.com/mail/?view=cm&fs=1&to=${siteConfig.links.email}&su=${encodeURIComponent("Hola Yeison")}`;

const education = [
  ["Tecnicatura en Desarrollo de Software", "Universidad Provincial de Ezeiza", "2025 a hoy"],
  ["Inglés, nivel 4 de 6", "Centro de Idiomas, UPE", "2026"],
  ["Big O, algoritmos y estructuras de datos", "Udemy", "2025"],
  ["Backend avanzado: APIs y bases de datos", "Aprende Programando", "2023"],
  ["React", "Aprende Programando", "2023"],
  ["JavaScript y MySQL", "Aprende Programando, UTN", "2022"],
  ["Fundamentos web", "Aprende Programando, UTN", "2022"],
];
const stack = [
  ["Java 21 y Spring Boot", "TechLab, Friv"],
  ["TypeScript, Node y Fastify", "DocSearch, Garmin Coach"],
  ["Go y Gin", "Short URL"],
  ["PostgreSQL, pgvector, Flyway", "TechLab, DocSearch"],
  ["React y Next.js", "RoadEra"],
  ["GitHub Actions, Docker, Git", "todos"],
];
---

<Site
  title="Yeison Fajardo, desarrollador backend"
  description="Yeison Fajardo, desarrollador backend en Buenos Aires. Estudia la Tecnicatura en Desarrollo de Software en la UPE y busca su primer trabajo."
>
  <header class="hero">
    <div class="topbar">
      <a class="monogram" href="#top" aria-label="Yeison Fajardo, inicio">YF</a>
      <nav aria-label="Secciones">
        <a href="#proyectos">Proyectos</a>
        <a href="#formacion">Formación</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </div>
    <div class="hero-main">
      <h1 class="name lines" id="top">
        <span class="line"><span data-line class="one" style="--i:0">Yeison</span></span>
        <span class="line"><span data-line class="two" style="--i:1">Fajardo</span></span>
      </h1>
      <img class="hero-photo" src="/Yeison-fajardo.webp" alt="Yeison Fajardo" width="260" height="260" />
    </div>
    <div class="hero-cells">
      <div class="cell intro">
        <img class="face" src="/Yeison-fajardo.webp" alt="Yeison Fajardo" width="96" height="96" />
        <p>Desarrollador backend en Buenos Aires. Estudio la Tecnicatura en Desarrollo de Software en la UPE y busco mi primer trabajo.</p>
      </div>
      <a class="cell key primary" href={mail} target="_blank" rel="noopener">Escribime</a>
      <a class="cell key" href={siteConfig.links.linkedin} rel="noopener">LinkedIn</a>
      <a class="cell key" href={siteConfig.links.github} rel="noopener">GitHub</a>
      <a class="cell key" href="/cv-yeison-fajardo.pdf">CV</a>
    </div>
  </header>

  <main>
    <section class="projects" id="proyectos" aria-labelledby="projects-title">
      <h2 class="section-title" id="projects-title">Proyectos</h2>
      <div class="grid">
        {work.map((p) => (
          <article class="cell project">
            {shots[p.slug] && <img class="p-shot" src={shots[p.slug].src} alt={shots[p.slug].alt} loading="lazy" width="1280" height="800" />}
            <h3>{p.title}</h3>
            <p class="p-meta">{p.discipline}</p>
            <p>{p.summary}</p>
            {p.bug && <p><strong>Qué arreglé:</strong> {p.bug.charAt(0).toLowerCase() + p.bug.slice(1)}. {p.story}</p>}
            <p class="p-stack"><span>Hecho con</span> {p.tags.join(", ")}</p>
            <p class="keys">
              {p.github && <a class="key" href={p.github} rel="noopener">Código</a>}
              {p.link && <a class="key" href={p.link} rel="noopener">Demo</a>}
              {extraLinks[p.slug] && <a class="key" href={extraLinks[p.slug].href} rel="noopener">{extraLinks[p.slug].label}</a>}
            </p>
            {p.diff && (
              <details class="fix">
                <summary>Ver el código del arreglo</summary>
                <figure class="diff">
                  <figcaption><code>{p.diff.file}</code></figcaption>
                  <pre>{p.diff.lines.map((l) => <code class={l.t === "+" ? "add" : l.t === "-" ? "del" : ""}>{l.t} {l.c}</code>)}</pre>
                </figure>
                {p.commit && <a href={p.commit} rel="noopener">Ver el commit en GitHub</a>}
              </details>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="about" aria-labelledby="about-title">
      <h2 class="section-title" id="about-title">Sobre mí</h2>
      <div class="grid about-grid">
        <p class="cell story">Me interesa el backend: APIs, bases de datos y lo que pasa cuando dos pedidos llegan al mismo tiempo. Trabajo sobre todo con Java y Spring Boot, TypeScript y PostgreSQL, y a cada proyecto le pongo tests y un CI que los corre. También armo herramientas propias, como un agente que corre con un modelo local en mi GPU y un servidor MCP publicado en npm.</p>
        <dl class="facts">
          <div class="cell"><dt>Edad</dt><dd>21 años</dd></div>
          <div class="cell"><dt>Ciudad</dt><dd>Buenos Aires</dd></div>
          <div class="cell"><dt>Inglés</dt><dd>Nivel 4 de 6</dd></div>
          <div class="cell"><dt>Busco</dt><dd>Junior o pasantía, backend</dd></div>
        </dl>
      </div>
    </section>

    <section class="cv" id="formacion" aria-label="Formación y stack">
      <div class="panel">
        <h2 class="section-title">Formación</h2>
        <ul class="ledger">
          {education.map(([what, where, when]) => (
            <li><span class="l-what">{what}</span><span class="l-where">{where}</span><span class="l-when">{when}</span></li>
          ))}
        </ul>
      </div>
      <div class="panel">
        <h2 class="section-title">Con qué trabajo</h2>
        <ul class="ledger">
          {stack.map(([what, where]) => (
            <li><span class="l-what">{what}</span><span class="l-where">{where}</span></li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="close" id="contacto">
    <h2 class="section-title">Contacto</h2>
    <a class="mail" href={mail} target="_blank" rel="noopener"><span>andresfajardo1606</span><span>@gmail.com</span></a>
    <div class="grid close-cells">
      <a class="cell key" href={siteConfig.links.linkedin} rel="noopener">LinkedIn</a>
      <a class="cell key" href={siteConfig.links.github} rel="noopener">GitHub</a>
      <a class="cell key" href="/cv-yeison-fajardo.pdf">CV en PDF</a>
      <a class="cell key" href="https://www.npmjs.com/package/garmin-coach-mcp" rel="noopener">npm</a>
    </div>
    <p class="meta">Buenos Aires, Argentina (UTC-3). 2026.</p>
  </footer>
  <EnergyRibbon />
</Site>
