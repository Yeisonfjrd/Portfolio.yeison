---
import { getCollection } from "astro:content";
import Site from "@/layouts/Site.astro";
import Arrow from "@/components/Arrow.astro";
import { siteConfig } from "@/data/site";

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = await Promise.all(
  all.filter((p) => p.data.featured).map(async (p) => ({ ...p, Story: (await p.render()).Content })),
);
const others = all.filter((p) => !p.data.featured);

const { links } = siteConfig;
const out = { target: "_blank", rel: "noopener noreferrer" };

const education = [
  ["2025 – hoy", "Tecnicatura en Desarrollo de Software", "Universidad Provincial de Ezeiza"],
  ["2026 – hoy", "Inglés, nivel 4 de 6", "Centro de Idiomas, UPE"],
  ["2025", "Big O, algoritmos y estructuras de datos", "Udemy"],
  ["2023", "Backend: APIs y bases de datos", "Aprende Programando"],
  ["2022", "JavaScript y MySQL", "Aprende Programando y UTN"],
];
---

<Site title={`${siteConfig.name} · ${siteConfig.role}`} description={siteConfig.description}>
  <a class="skip" href="#proyectos">Ir a los proyectos</a>

  <header class="bar">
    <div class="wrap">
      <a class="home" href="#top">Yeison Fajardo</a>
      <nav aria-label="Secciones">
        <a href="#proyectos">Proyectos</a>
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#contacto">Contacto</a>
        <a class="btn" href={links.cv} {...out}>CV <Arrow /></a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero wrap">
      <h1 class="name"><span>Yeison</span> <span style="--d:90ms">Fajardo</span></h1>
      <div class="hero-row">
        <img class="portrait" src="/yeison-fajardo-300.webp" alt="Foto de Yeison Fajardo" width="132" height="132" />
        <p class="rise">Desarrollador backend junior. Estudio Desarrollo de Software en la UPE y hago APIs en Java y Spring Boot.</p>
        <div class="actions rise" style="--d:80ms">
          <a class="btn main" href={links.gmail} {...out}>Escribime <Arrow /></a>
          <a class="btn" href={links.linkedin} {...out}>LinkedIn <Arrow /></a>
          <a class="btn" href={links.github} {...out}>GitHub <Arrow /></a>
        </div>
      </div>
      <dl class="facts rise" style="--d:160ms">
        <div class="seek"><dt>Busco</dt><dd>Mi primer trabajo como <mark>backend junior</mark></dd></div>
        <div><dt>Lo que más uso</dt><dd><ul class="keys main-stack"><li>Java 21</li><li>Spring Boot</li><li>PostgreSQL</li></ul></dd></div>
        <div><dt>También</dt><dd><ul class="keys"><li>TypeScript</li><li>Node</li><li>Go</li></ul></dd></div>
        <div class="where"><dt>Vivo en</dt><dd>Ezeiza, Buenos Aires<span>Inglés intermedio · <span>acá son las <time data-clock>--:--</time> (GMT-3)</span></span></dd></div>
      </dl>
    </section>

    <div id="proyectos" class="wrap">
      {featured.map(({ data, Story }) => (
        <article class:list={["project", { fer: data.title === "Fer Fit Laguna" }]}>
          <div class="pin">
            <h2>{data.title}</h2>
            <div class="story"><Story /></div>
            <p class="stack">{[String(data.year), ...data.stack].join(" · ")}</p>
            <div class="links">
              {data.github && <a href={data.github} {...out}>Código en GitHub <Arrow /></a>}
              {data.links.map((l) => <a href={l.href} {...out}>{l.label} <Arrow /></a>)}
              {data.privateNote && <span>{data.privateNote}</span>}
            </div>
          </div>
          <div class="screens">
            {data.testimonial && (
              <figure class="rise review">
                <blockquote><p>{data.testimonial.quote}</p></blockquote>
                <figcaption><b>{data.testimonial.author}</b>, {data.testimonial.role}</figcaption>
              </figure>
            )}
            {data.facts.length > 0 && (
              <dl class="project-facts rise">
                {data.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
              </dl>
            )}
            {data.figures.map((f) => (
              <figure class="rise">
                <div class={f.kind === "phones" ? "phones" : "shot"}>
                  {f.screens.map((s) => (
                    <img src={s.src} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
                  ))}
                </div>
                <figcaption>{f.caption}</figcaption>
              </figure>
            ))}
            {data.numbers && (
              <figure class="rise">
                <div class="numbers">
                  <table>
                    <thead>
                      <tr>{data.numbers.columns.map((c) => <th scope="col">{c}</th>)}</tr>
                    </thead>
                    <tbody>
                      {data.numbers.rows.map((r) => (
                        <tr>
                          <td>{r.label}</td>
                          {r.values.map((v) => <td class="n">{v}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p>{data.numbers.note}</p>
                </div>
              </figure>
            )}
          </div>
        </article>
      ))}
    </div>

    <section class="lineup wrap" aria-labelledby="otros">
      <h2 id="otros">Otros proyectos</h2>
      <ul>
        {others.map(({ data }) => (
          <li class="rise">
            {data.github
              ? <a class="title" href={data.github} {...out}>{data.title}</a>
              : <span class="title">{data.title}</span>}
            <span>{data.summary}</span>
            <span class="side">
              {data.privateNote ? `${data.privateNote} · ` : ""}{data.stack.join(" · ")}
              {data.links.map((l) => <> · <a href={l.href} {...out}>{l.label}</a></>)}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section id="sobre-mi" class="about wrap">
      <div>
        <h2>Sobre mí</h2>
        <p class="me rise">Tengo 21 años y busco mi primer trabajo como desarrollador backend junior.</p>
        <p class="rise" style="--d:80ms">Empecé a programar a los 16 con cursos de JavaScript. Hoy me gusta más lo que no se ve: la base de datos, los tests y que algo siga andando cuando lo usa gente real.</p>
      </div>
      <ol aria-label="Formación">
        {education.map(([when, what, where]) => (
          <li class="rise"><span>{when}</span><div><b>{what}</b><i>{where}</i></div></li>
        ))}
      </ol>
    </section>

    <section id="contacto" class="contact">
      <div class="wrap">
        <p class="say">Si buscás un backend junior o querés charlar de algún proyecto, escribime.</p>
        <a class="mail" href={links.gmail} {...out}>{siteConfig.email.split("@")[0]}@<wbr />{siteConfig.email.split("@")[1]}</a>
        <div class="contact-actions">
          <a class="btn" href={links.gmail} {...out}>Abrir Gmail <Arrow /></a>
          <button class="btn ghost" type="button" data-copy={siteConfig.email}><span class="label">Copiar email</span></button>
          <a class="btn ghost" href={links.cv} {...out}>Descargar CV <Arrow /></a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span><b>Yeison Fajardo</b> · Backend junior · Ezeiza, Buenos Aires</span>
      <nav aria-label="Enlaces">
        <a href={links.linkedin} {...out}>LinkedIn</a>
        <a href={links.github} {...out}>GitHub</a>
        <a href="#top">Volver arriba</a>
      </nav>
    </div>
  </footer>

  <script>
    // Each block rises once when it comes into view
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }),
      { rootMargin: "0px 0px -8% 0px" },
    );
    document.querySelectorAll(".rise").forEach((el) => io.observe(el));

    // My local time, so whoever reads this knows if I'm awake
    const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
    if (clock) {
      const fmt = new Intl.DateTimeFormat("es-AR", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "America/Argentina/Buenos_Aires" });
      const tick = () => { clock.textContent = fmt.format(new Date()); };
      tick();
      setInterval(tick, 30_000);
    }

    // Copy the address; if the clipboard is blocked, select the text so it can be copied by hand
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.querySelector(".label");
        if (!text) return;
        const label = text.textContent;
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
          text.textContent = "Copiado";
          btn.dataset.done = "";
        } catch {
          const mail = document.querySelector(".mail");
          if (mail) window.getSelection()?.selectAllChildren(mail);
          text.textContent = "Seleccionado, copialo";
        }
        setTimeout(() => { text.textContent = label; delete btn.dataset.done; }, 1800);
      });
    });
  </script>
</Site>
